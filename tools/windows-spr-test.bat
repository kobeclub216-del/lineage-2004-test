@echo off
setlocal
powershell.exe -NoProfile -STA -Command "& { Add-Type -AssemblyName System.Windows.Forms; $f=New-Object System.Windows.Forms.OpenFileDialog; $f.Title='Select pakviewer-cli.exe'; $f.Filter='CLI executable|pakviewer-cli.exe'; if($f.ShowDialog() -ne 'OK'){return}; $cli=$f.FileName; $d=New-Object System.Windows.Forms.FolderBrowserDialog; $d.Description='Select Lineage client folder'; if($d.ShowDialog() -ne 'OK'){return}; $src=$d.SelectedPath; $out=Join-Path ([Environment]::GetFolderPath('Desktop')) ('Lineage-SPR-test-'+[Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $out | Out-Null; $names=@('1312-13.spr','4192-2.spr','7187-29.spr','1775-40.spr','4068-34.spr','2540-38.spr','3944-3.spr','1245-70.spr'); foreach($n in $names){$dest=Join-Path $out ([IO.Path]::GetFileNameWithoutExtension($n)); New-Item -ItemType Directory -Path $dest | Out-Null; & $cli spr info $src $n *> (Join-Path $dest 'info.txt'); & $cli spr export $src $n -o $dest *> (Join-Path $dest 'export.txt'); $code=$LASTEXITCODE; $count=@(Get-ChildItem -LiteralPath $dest -Filter '*.png' -File).Count; Add-Content -LiteralPath (Join-Path $out 'summary.txt') -Value ('{0}: exit={1}, PNG={2}' -f $n,$code,$count)}; Invoke-Item -LiteralPath $out }"
pause
