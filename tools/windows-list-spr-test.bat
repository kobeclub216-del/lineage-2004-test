@echo off
setlocal
echo Select the Lineage client folder.
powershell.exe -NoProfile -STA -Command "& { Add-Type -AssemblyName System.Windows.Forms; $d=New-Object System.Windows.Forms.FolderBrowserDialog; $d.Description='Select Lineage client folder'; if($d.ShowDialog() -ne 'OK'){return}; $src=$d.SelectedPath; $out=Join-Path ([Environment]::GetFolderPath('Desktop')) ('Lineage-list-test-'+[Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $out | Out-Null; Get-ChildItem -LiteralPath $src -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -in @('list.spr','wlist.spr') } | ForEach-Object { $dest=Join-Path $out ([Guid]::NewGuid().ToString('N').Substring(0,8)+'-'+$_.Name); Copy-Item -LiteralPath $_.FullName -Destination $dest; Add-Content -LiteralPath (Join-Path $out 'summary.txt') -Value ($_.FullName+' -> '+$dest) }; Get-ChildItem -LiteralPath $src -Filter '*.idx' -File | Select-Object Name,Length | Out-File -LiteralPath (Join-Path $out 'indexes.txt'); if(!(Test-Path (Join-Path $out 'summary.txt'))){Set-Content -LiteralPath (Join-Path $out 'summary.txt') -Value 'No loose list.spr or wlist.spr found. Archive lookup required.'}; $f=New-Object System.Windows.Forms.OpenFileDialog; $f.Title='Select pakviewer-cli.exe for archive lookup'; $f.Filter='CLI executable|pakviewer-cli.exe'; if($f.ShowDialog() -eq 'OK'){ $cli=$f.FileName; foreach($idx in (Get-ChildItem -LiteralPath $src -Filter '*.idx' -File)){ Write-Host ('Searching '+$idx.Name); & $cli pak search $idx.FullName list 2>&1 | Out-File -LiteralPath (Join-Path $out 'list-candidates.txt') -Append -Encoding utf8; foreach($n in @('list.spr','wlist.spr')){ $dest=Join-Path $out ($idx.BaseName+'-'+$n); $log=Join-Path $out 'archive-search.txt'; Add-Content -LiteralPath $log -Value ($idx.Name+' '+$n); & $cli pak extract $idx.FullName $n -o $dest 2>&1 | Out-File -LiteralPath $log -Append -Encoding utf8; $code=$LASTEXITCODE; if($code -eq 0 -and (Test-Path -LiteralPath $dest) -and (Get-Item -LiteralPath $dest).Length -gt 0){Add-Content -LiteralPath (Join-Path $out 'summary.txt') -Value ('Archive candidate: '+$dest)} elseif(Test-Path -LiteralPath $dest){Remove-Item -LiteralPath $dest} } } }; Invoke-Item -LiteralPath $out }"
pause
