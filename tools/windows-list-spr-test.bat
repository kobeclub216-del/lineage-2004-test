@echo off
setlocal
echo Select the Lineage client folder.
powershell.exe -NoProfile -STA -Command "& { Add-Type -AssemblyName System.Windows.Forms; $d=New-Object System.Windows.Forms.FolderBrowserDialog; $d.Description='Select Lineage client folder'; if($d.ShowDialog() -ne 'OK'){return}; $src=$d.SelectedPath; $out=Join-Path ([Environment]::GetFolderPath('Desktop')) ('Lineage-list-test-'+[Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $out | Out-Null; Get-ChildItem -LiteralPath $src -File -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.Name -in @('list.spr','wlist.spr') } | ForEach-Object { $dest=Join-Path $out ([Guid]::NewGuid().ToString('N').Substring(0,8)+'-'+$_.Name); Copy-Item -LiteralPath $_.FullName -Destination $dest; Add-Content -LiteralPath (Join-Path $out 'summary.txt') -Value ($_.FullName+' -> '+$dest) }; Get-ChildItem -LiteralPath $src -Filter '*.idx' -File | Select-Object Name,Length | Out-File -LiteralPath (Join-Path $out 'indexes.txt'); if(!(Test-Path (Join-Path $out 'summary.txt'))){Set-Content -LiteralPath (Join-Path $out 'summary.txt') -Value 'No loose list.spr or wlist.spr found. Archive lookup required.'}; Invoke-Item -LiteralPath $out }"
pause
